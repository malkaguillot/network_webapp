# Copy this file to .streamlit/secrets.toml and fill in your values.
# NEVER commit secrets.toml to git — it is listed in .gitignore.
#
# For Streamlit Cloud deployment, enter these values in:
#   App settings → Secrets
#
# The app consumes 5 "app-ready" CSVs produced by the companion project
# (journalism-quality/code/2-clean-merge-sources/orbis/build_app_data.py), which
# live in data/source/Orbis/network/app/:
#   app_edges_by_year.csv
#   app_outlet_se_by_year.csv
#   app_groups_by_year.csv
#   app_outlet_stats_by_year.csv
#   app_changes.csv

# --- Option 1 (recommended: works everywhere) — Dropbox shared links ---
# Set ALL 5 links. Paste regular Dropbox share URLs; the app forces dl=1 automatically.
DROPBOX_URL_APP_EDGES     = "https://www.dropbox.com/.../app_edges_by_year.csv?..."
DROPBOX_URL_APP_OUTLET_SE = "https://www.dropbox.com/.../app_outlet_se_by_year.csv?..."
DROPBOX_URL_APP_GROUPS    = "https://www.dropbox.com/.../app_groups_by_year.csv?..."
DROPBOX_URL_APP_STATS     = "https://www.dropbox.com/.../app_outlet_stats_by_year.csv?..."
DROPBOX_URL_APP_CHANGES   = "https://www.dropbox.com/.../app_changes.csv?..."

# --- Option 2 (local development only) — folder with the 5 CSVs ---
# DROPBOX_LOCAL_APP_FOLDER = "/Users/yourname/Dropbox/.../data/source/Orbis/network/app"

# --- Option 3 (legacy) — Dropbox API via refresh token ---
# DROPBOX_APP_KEY         = "your_app_key_here"
# DROPBOX_APP_SECRET      = "your_app_secret_here"
# DROPBOX_REFRESH_TOKEN   = "your_refresh_token_here"
# DROPBOX_APP_DATA_FOLDER = "/01_Research/.../data/source/Orbis/network/app"
